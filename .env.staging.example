# Hosted staging configuration. Copy into a secret manager or an ignored local file.
# Do not use the Supabase project owner database password for runtime connections.
WF_ENV=staging
WF_IDENTITY_PROVIDER=supabase
WF_SUPABASE_URL=https://xfxqlcmsfkbvbybkrppq.supabase.co
WF_SUPABASE_PUBLISHABLE_KEY=
WF_ENABLE_PG_GUEST_API=1
WF_DATA_KEYS_JSON=
WF_DATA_ACTIVE_KEY_ID=
# Only needed for legacy ciphertext:
WF_DATA_KEY_B64=
WF_GUEST_QUOTA_SECRET=
# All connection strings must use distinct restricted logins and verified TLS.
WF_GUEST_POSTGRES_DSN=
WF_STAFF_POSTGRES_DSN=
WF_STAFF_LIFECYCLE_POSTGRES_DSN=
WF_EVENT_PROJECTOR_POSTGRES_DSN=
WF_PROPERTY_CONFIG_POSTGRES_DSN=
WF_GUEST_QUOTA_POSTGRES_DSN=
WF_DOCUMENT_POSTGRES_DSN=
# Keep operator credentials outside the API and worker runtime:
# WF_HOTEL_PROVISIONER_POSTGRES_DSN=
# WF_DB_PREFLIGHT_DSN=

# Q2 runtime roles
WF_OPERATIONS_POSTGRES_DSN=
WF_PUBLIC_CONTENT_POSTGRES_DSN=
# Optional external provider credentials: use secret manager, not git.
WF_PAYMENT_PROVIDER_POSTGRES_DSN=
WF_PAYSTACK_ACCOUNTS_JSON=
WF_PAYSTACK_LIVE_ENABLED=0
WF_CLOUDBEDS_ACCOUNTS_JSON=

WF_POS_PROVIDER_POSTGRES_DSN=
WF_LOYVERSE_ACCOUNTS_JSON=

WF_PMS_PROVIDER_POSTGRES_DSN=

# Keep PMS writes off until provider acceptance.
WF_CLOUDBEDS_WRITES_ENABLED=0
# Enable the pos-sync Compose profile only with authorized credentials.
WF_POS_SYNC_POSTGRES_DSN=
